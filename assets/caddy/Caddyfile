# Caddy site block for mdedit's browser version: Caddy terminates HTTPS
# for markdown.phonax.com and passes requests on to mdedit-web in the
# FreeBSD jail (port 8089, see assets/freebsd/mdedit_web).
#
# Replace JAIL_IP with the jail's address (on the host: jls -j 100 ip4.addr).
#
# No "encode" directive: mdedit-web already sends pre-compressed copies
# (brotli, gzip) of the 30 MB mdedit.wasm, and Caddy passes them through.

markdown.phonax.com {
	reverse_proxy JAIL_IP:8089

	header {
		# HTTPS only from now on; also what the browser's clipboard needs.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
